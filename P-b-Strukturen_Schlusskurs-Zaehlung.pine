//@version=6
// =============================================================================
//  P-/b-Strukturen  —  Schlusskurs-Zählung (PbD-Methodik)
//  Trade The Trader Ausbildung · Modul 4 · "Schlusskurs-Zählung — PbD-Methodik"
//
//  Logik (1:1 aus der Notion-Datenbank):
//   • Range-High (Long-Trend): Referenz = Schlusskurs der letzten Kerze des
//     Aufwärtsimpulses.
//       - Kerze schließt HÖHER          -> Referenz wird aktualisiert (Trend läuft)
//       - Kerze schließt gleich/tiefer  -> Bewegung gegen den Trend
//       - ZWEI Kerzen in Folge gleich/tiefer -> Referenz wird als Range-High markiert
//   • Range-Low: Referenz = tiefster Schlusskurs innerhalb der Gegenbewegung.
//       - Kerze schließt TIEFER         -> Referenz wird aktualisiert
//       - Kerze schließt gleich/höher   -> Bewegung zurück in Trendrichtung
//       - ZWEI Kerzen in Folge gleich/höher -> Referenz wird als Range-Low markiert
//   • P-Struktur  = Aufwärtsimpuls + Konsolidierung in Range (Long-Richtung)
//   • b-Struktur  = Abwärtsimpuls  + Konsolidierung in Range (Short-Richtung)
//   • Für Short-Trends gilt dieselbe Logik spiegelverkehrt.
//
//  WICHTIG (Korrektur ggü. v1): Eine Struktur entsteht nur aus IMPULS + folgender
//  KONSOLIDIERUNG. Die Trendrichtung wird über den Vergleich aufeinanderfolgender
//  Pivots bestimmt:
//   • Höheres Tief nach einem Aufwärtsimpuls -> P-Struktur (der Impuls selbst
//     bekommt KEINE Box).
//   • Tieferes Hoch nach einem Abwärtsimpuls -> b-Struktur (der Impuls selbst
//     bekommt KEINE Box).
//
//  Der Indikator nutzt automatisch den aktuell im Chart geöffneten Time Frame.
// =============================================================================
indicator("P-/b-Strukturen (Schlusskurs-Zählung)", shorttitle="PbD", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ===================== Eingaben ==============================================
grpL = "Logik"
confirmBars = input.int(2, "Bestätigungskerzen", minval=1, maxval=10, group=grpL, tooltip="Anzahl aufeinanderfolgender Schlusskurse gegen die Trendrichtung, die eine Range-Grenze bestätigen. Notion-Methodik = 2.")
minRatio    = input.float(3.0, "Mindestverhältnis Bewegung:Konsolidierung", minval=1.0, step=0.5, group=grpL, tooltip="Die Impulsbewegung muss mindestens dieses Vielfache der Konsolidierungs-(Box-)Höhe betragen, damit eine Struktur gezeichnet wird. Default 3 = 3:1.")
useConfirmed = input.bool(true, "Nur abgeschlossene Kerzen verwenden (kein Repainting)", group=grpL, tooltip="An: Zählung erfolgt erst beim Kerzenschluss. Aus: aktualisiert live (kann repainten).")

grpV = "Darstellung"
showBoxes   = input.bool(true,  "Strukturen (Boxen) anzeigen", group=grpV)
showPivots  = input.bool(true,  "Range-High/Low markieren",    group=grpV)
showLabels  = input.bool(true,  "P/b Beschriftung anzeigen",   group=grpV)
extendLast  = input.bool(true,  "Letzte Struktur nach rechts verlängern", group=grpV)

grpC = "Farben"
pFill   = input.color(color.new(color.teal, 82), "P-Struktur Füllung", group=grpC)
pBorder = input.color(color.teal,                "P-Struktur Rahmen",  group=grpC)
bFill   = input.color(color.new(color.red, 82),  "b-Struktur Füllung", group=grpC)
bBorder = input.color(color.red,                 "b-Struktur Rahmen",  group=grpC)

// ===================== Status (persistent) ===================================
var int   dir    = 1      // +1 = Aufwärtsimpuls (Range-High tracken), -1 = Abwärtsimpuls (Range-Low tracken)
var float refExt = na     // Extrem-Schlusskurs in Trendrichtung (Pivot-Kandidat)
var int   refBar = na
var float ctrExt = na     // Extrem-Schlusskurs der laufenden Gegenbewegung
var int   ctrBar = na
var int   cnt    = 0      // Zähler der Gegen-Schlusskurse

// Zuletzt bestätigte Pivots (für Trendbestimmung + Box-Aufbau)
var float lastHighPrice = na
var int   lastHighBar   = na
var float lastLowPrice  = na
var int   lastLowBar     = na

var box   lastBox = na

// ===================== Verarbeitung pro Bar ==================================
bool proceed = useConfirmed ? barstate.isconfirmed : true

// Lock-Resultat dieser Bar (nicht-persistent)
bool  lockNow    = false
float lockPrice  = na
int   lockBar    = na
bool  lockIsHigh = false

if proceed
    if na(refExt)
        // Initialisierung mit der ersten verarbeiteten Kerze
        refExt := close
        refBar := bar_index
    else if dir == 1
        // --- Aufwärtsimpuls: Range-High suchen --------------------------------
        if close > refExt
            refExt := close
            refBar := bar_index
            cnt    := 0
            ctrExt := na
        else
            // Schlusskurs gleich oder tiefer -> Gegenbewegung
            cnt += 1
            if na(ctrExt) or close < ctrExt
                ctrExt := close
                ctrBar := bar_index
            if cnt >= confirmBars
                // Range-High bestätigt
                lockNow    := true
                lockPrice  := refExt
                lockBar    := refBar
                lockIsHigh := true
                // Umschalten auf Range-Low-Suche; Gegen-Extrem wird neuer Kandidat
                dir    := -1
                refExt := ctrExt
                refBar := ctrBar
                cnt    := 0
                ctrExt := na
    else
        // --- Abwärtsimpuls: Range-Low suchen ----------------------------------
        if close < refExt
            refExt := close
            refBar := bar_index
            cnt    := 0
            ctrExt := na
        else
            // Schlusskurs gleich oder höher -> Gegenbewegung
            cnt += 1
            if na(ctrExt) or close > ctrExt
                ctrExt := close
                ctrBar := bar_index
            if cnt >= confirmBars
                // Range-Low bestätigt
                lockNow    := true
                lockPrice  := refExt
                lockBar    := refBar
                lockIsHigh := false
                dir    := 1
                refExt := ctrExt
                refBar := ctrBar
                cnt    := 0
                ctrExt := na

// ===================== Strukturerkennung & Zeichnen ==========================
if lockNow
    // Pivot-Markierung (Range-High / Range-Low)
    if showPivots
        label.new(lockBar, lockPrice, lockIsHigh ? "RH" : "RL", xloc=xloc.bar_index, yloc=yloc.price, style=lockIsHigh ? label.style_label_down : label.style_label_up, color=lockIsHigh ? color.new(bBorder, 20) : color.new(pBorder, 20), textcolor=color.white, size=size.tiny)

    if lockIsHigh
        // Neues Range-High bestätigt.
        // b-Struktur NUR, wenn es ein TIEFERES Hoch ist (= Abwärtstrend-Pullback);
        // ein höheres Hoch ist ein Aufwärtsimpuls und bekommt KEINE Box.
        // Zusätzlich muss der Abwärtsimpuls mind. minRatio-mal so groß sein wie die
        // Konsolidierung (Box-Höhe).
        float impulseB = lastHighPrice - lastLowPrice   // Abwärtsimpuls (vorheriges Hoch -> Tief)
        float consolB  = lockPrice - lastLowPrice       // Konsolidierung (Box-Höhe)
        bool isB = not na(lastHighPrice) and not na(lastLowPrice) and lockPrice < lastHighPrice and consolB > 0 and impulseB >= minRatio * consolB
        if isB and showBoxes
            box nb = box.new(lastLowBar, lockPrice, lockBar, lastLowPrice, xloc=xloc.bar_index, border_color=bBorder, border_width=1, bgcolor=bFill)
            lastBox := nb
            if showLabels
                label.new(lockBar, lockPrice, "b", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=bBorder, textcolor=color.white, size=size.normal)
        // Pivot merken
        lastHighPrice := lockPrice
        lastHighBar   := lockBar
    else
        // Neues Range-Low bestätigt.
        // P-Struktur NUR, wenn es ein HÖHERES Tief ist (= Aufwärtstrend-Pullback);
        // ein tieferes Tief ist ein Abwärtsimpuls und bekommt KEINE Box.
        // Zusätzlich muss der Aufwärtsimpuls mind. minRatio-mal so groß sein wie die
        // Konsolidierung (Box-Höhe).
        float impulseP = lastHighPrice - lastLowPrice   // Aufwärtsimpuls (vorheriges Tief -> Hoch)
        float consolP  = lastHighPrice - lockPrice      // Konsolidierung (Box-Höhe)
        bool isP = not na(lastLowPrice) and not na(lastHighPrice) and lockPrice > lastLowPrice and consolP > 0 and impulseP >= minRatio * consolP
        if isP and showBoxes
            box nb = box.new(lastHighBar, lastHighPrice, lockBar, lockPrice, xloc=xloc.bar_index, border_color=pBorder, border_width=1, bgcolor=pFill)
            lastBox := nb
            if showLabels
                label.new(lastHighBar, lastHighPrice, "P", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=pBorder, textcolor=color.white, size=size.normal)
        // Pivot merken
        lastLowPrice := lockPrice
        lastLowBar   := lockBar

// Aktive (letzte) Struktur live nach rechts verlängern
if extendLast and not na(lastBox)
    box.set_right(lastBox, bar_index)

// =============================================================================
// ╔═══════════════════════════════════════════════════════════════════════════
// ║  OPTIONAL: INSIDE- / OUTSIDE-BARS  —  START
// ║  (Modul 4 · "Der Inside-Bar" / "Der Outside-Bar")
// ║
// ║  Zum Entfernen dieser Funktionalität einfach den kompletten Block zwischen
// ║  "INSIDE-/OUTSIDE-BARS — START" und "INSIDE-/OUTSIDE-BARS — ENDE" löschen.
// ║  Inside- und Outside-Bars sind getrennt schaltbar, beide standardmäßig AUS.
// ║
// ║   • Inside-Bar : Kerze liegt vollständig innerhalb der Vorkerzen-Range
// ║                  (high <= high[1] und low >= low[1]). Akkumulation im Trend.
// ║                  -> wird mit einer grauen Box markiert.
// ║   • Outside-Bar: Kerze umschließt die Vorkerze komplett (high >= high[1]
// ║                  und low <= low[1]). Hinweis auf mögliche Trendumkehr.
// ╚═══════════════════════════════════════════════════════════════════════════
grpIO = "Inside-/Outside-Bars (optional)"
showInside  = input.bool(false, "Inside-Bars anzeigen",  group=grpIO, tooltip="Standardmäßig deaktiviert. Markiert Inside-Bars (Akkumulation) mit einer grauen Box. Es wird immer nur eine Inside-Bar gleichzeitig verwaltet (keine Verschachtelung).")
extendIB    = input.bool(false, "Inside-Bar Box erweitern (Re-Test)", group=grpIO, tooltip="Aus: Box endet x Balken nachdem der Kurs sie per Schlusskurs verlassen hat. An: Box wird auch nach dem Verlassen weiter nach rechts verlängert, bis der Kurs sie erneut anläuft (Re-Test).")
extendBars  = input.int(3, "↳ Erweiterung in Balken (wenn 'erweitern' = Aus)", minval=0, maxval=100, group=grpIO)
showOutside = input.bool(false, "Outside-Bars anzeigen", group=grpIO, tooltip="Standardmäßig deaktiviert. Markiert Outside-Bars (mögliche Trendumkehr).")
ibBorder = input.color(color.new(color.gray, 0),  "Inside-Bar Box (Rahmen)",  group=grpIO)
ibFill   = input.color(color.new(color.gray, 80), "Inside-Bar Box (Füllung)", group=grpIO)
obColor  = input.color(color.fuchsia,             "Outside-Bar Farbe",        group=grpIO)

bool isInsideBar  = high <= high[1] and low >= low[1]
bool isOutsideBar = high >= high[1] and low <= low[1]

// --- Inside-Bar Zustandsmaschine -------------------------------------------
// Es ist immer nur EINE Inside-Bar-Box aktiv (verhindert verschachtelte Inside-
// Bars). Eine neue Inside-Bar wird erst erkannt, wenn die aktive abgeschlossen ist.
var bool  ibActive = false   // Box wird gerade verwaltet
var bool  ibBroken = false   // Kurs hat die Box per Schlusskurs verlassen
var bool  ibLeft   = false   // Kurs hat die Box nach dem Ausbruch vollständig verlassen
var float ibTop    = na
var float ibBot    = na
var box   ibBox    = na

if showInside and barstate.isconfirmed
    if ibActive
        // Box immer bis zur aktuellen Kerze nach rechts mitführen
        box.set_right(ibBox, bar_index)
        if not ibBroken
            // Ausbruch = Schlusskurs außerhalb der Box-Range
            if close > ibTop or close < ibBot
                ibBroken := true
                if not extendIB
                    // 'Erweitern' = Aus: noch x Balken verlängern und abschließen
                    box.set_right(ibBox, bar_index + extendBars)
                    ibActive := false
        else
            // 'Erweitern' = An: weiter verlängern bis zum erneuten Anlaufen (Re-Test)
            if not ibLeft
                // warten, bis der Kurs die Box vollständig verlassen hat
                if low > ibTop or high < ibBot
                    ibLeft := true
            else
                // erneutes Anlaufen: Kerzen-Range berührt die Box wieder
                if high >= ibBot and low <= ibTop
                    box.set_right(ibBox, bar_index)
                    ibActive := false
    else
        // keine aktive Box -> neue Inside-Bar darf entstehen
        if isInsideBar
            ibTop    := high
            ibBot    := low
            ibBroken := false
            ibLeft   := false
            ibActive := true
            // links 1 Bar Versatz, damit die Box von Beginn an sichtbar ist
            ibBox := box.new(bar_index - 1, ibTop, bar_index, ibBot, xloc=xloc.bar_index, border_color=ibBorder, border_width=1, bgcolor=ibFill)

// Outside-Bar: Marker unter der Kerze
plotshape(showOutside and isOutsideBar, title="Outside-Bar", style=shape.square, location=location.belowbar, color=obColor, textcolor=obColor, size=size.tiny, text="OB")
// ╔═══════════════════════════════════════════════════════════════════════════
// ║  OPTIONAL: INSIDE- / OUTSIDE-BARS  —  ENDE
// ╚═══════════════════════════════════════════════════════════════════════════
// =============================================================================
